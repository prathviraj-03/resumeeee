# ════════════════════════════════════════════════════════════════
#   AI Resume Service — Environment Variables Template (v2)
#   Copy to .env and fill in your values: cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_NAME="AI Resume Service"
APP_VERSION="2.0.0"
DEBUG=false
SECRET_KEY=change-me-in-production
PORT=8001

# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_resume
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── OpenAI ────────────────────────────────────────────────────────
# Required — get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
# Recommended: gpt-4o-mini (fast + cheap) | gpt-4o (higher quality)
OPENAI_MODEL=gpt-4o-mini

# ── Profile Service ───────────────────────────────────────────────
# The AI service fetches the user's master profile from here
# Local dev: http://localhost:3002
# Docker:    http://profile-service:3002
PROFILE_SERVICE_URL=http://localhost:3002

# ── Storage ───────────────────────────────────────────────────────
# Options: local | cloudinary
STORAGE_BACKEND=cloudinary
LOCAL_STORAGE_PATH=/tmp/ai_resume_storage

# Cloudinary (required when STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ai_resumes
