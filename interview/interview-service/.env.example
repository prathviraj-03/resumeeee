# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://interview_user:interview_pass@localhost:5432/interview_db
SYNC_DATABASE_URL=postgresql+psycopg2://interview_user:interview_pass@localhost:5432/interview_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ──────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM (OpenAI-compatible) ───────────────────────────────
# Option 1: OpenAI (paid)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option 2: Groq (FREE - https://console.groq.com)
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-70b-8192

# Option 3: Ollama (FREE, local)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# ── Cloudinary Storage ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=interview_audio

# ── App ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Question Bank Cache TTL (seconds) ─────────────────────
QUESTION_CACHE_TTL=3600
